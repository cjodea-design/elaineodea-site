---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Works from '../components/Works.astro';

export async function getStaticPaths() {
  const exhibitions = await getCollection('exhibitions');
  return exhibitions.map((e) => ({ params: { slug: e.id }, props: { exhibition: e } }));
}

const { exhibition } = Astro.props;
const d = exhibition.data;
const heading = d.heading ?? `${d.title} ${d.year}`;
const navLabel = `${d.title} ${d.year}`;
---

<Base title={navLabel} description={`${navLabel}${d.venue ? `, ${d.venue}` : ''} — sculpture by Elaine O'Dea.`}>
  <div class="page-head">
    <h1>{heading}</h1>
    {d.subtitle && <p class="venue">{d.subtitle}</p>}
    {d.venue && <p class="venue">{d.venue}</p>}
  </div>
  <Works layout={d.layout} works={d.works} heading={heading} />
</Base>
